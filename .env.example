# Supabase PostgreSQL connection string with transaction pooling (runtime)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL connection string for migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

# Application JWT secret. Generate a unique random value for each environment.
JWT_SECRET="replace-with-a-random-secret"

# Vercel Cron authorization secret. Use a different value from JWT_SECRET.
CRON_SECRET="replace-with-a-random-secret"

# Initial administrator seed credentials
SEED_ADMIN_EMAIL="admin@example.edu"
SEED_ADMIN_PASSWORD="replace-with-at-least-8-characters"
SEED_ADMIN_NAME="Administrador"
